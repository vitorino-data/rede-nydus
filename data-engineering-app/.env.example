# Credenciais da API da Blizzard
BLIZZARD_CLIENT_ID=seu_client_id_aqui
BLIZZARD_CLIENT_SECRET=seu_client_secret_aqui

# Banco de metadados do Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Banco de dados principal (silver/gold)
DATA_DB_USER=user
DATA_DB_PASSWORD=password
DATA_DB_NAME=mydatabase

# String de conexão usada pelos utils Python dentro do container Airflow.
# Em desenvolvimento local fora do Docker, troque postgres_data por localhost.
SILVER_DB_CONN=postgresql://user:password@postgres_data:5432/mydatabase
